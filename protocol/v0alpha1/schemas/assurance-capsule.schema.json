{
  "$defs": {
    "DisclosureMode": {
      "enum": [
        "METADATA",
        "SELECTIVE_EVIDENCE",
        "CONFIDENTIAL_CHALLENGE"
      ],
      "title": "DisclosureMode",
      "type": "string"
    },
    "DisclosurePolicy": {
      "additionalProperties": false,
      "properties": {
        "allowed_evidence_predicates": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Allowed Evidence Predicates",
          "type": "array"
        },
        "mode": {
          "$ref": "#/$defs/DisclosureMode"
        },
        "policy_id": {
          "minLength": 1,
          "title": "Policy Id",
          "type": "string"
        },
        "privacy_budget": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Privacy Budget",
          "type": "number"
        }
      },
      "required": [
        "policy_id",
        "mode",
        "privacy_budget"
      ],
      "title": "DisclosurePolicy",
      "type": "object"
    },
    "EvidenceReference": {
      "additionalProperties": false,
      "properties": {
        "commitment": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Commitment",
          "type": "string"
        },
        "predicate": {
          "minLength": 1,
          "title": "Predicate",
          "type": "string"
        }
      },
      "required": [
        "commitment",
        "predicate"
      ],
      "title": "EvidenceReference",
      "type": "object"
    },
    "SourceBinding": {
      "additionalProperties": false,
      "properties": {
        "commitment": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Commitment",
          "type": "string"
        },
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        }
      },
      "required": [
        "source_id",
        "commitment"
      ],
      "title": "SourceBinding",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "capsule_id": {
      "minLength": 1,
      "title": "Capsule Id",
      "type": "string"
    },
    "constraints": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Constraints",
      "type": "array"
    },
    "context": {
      "additionalProperties": true,
      "title": "Context",
      "type": "object"
    },
    "disclosure_policy": {
      "$ref": "#/$defs/DisclosurePolicy"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/EvidenceReference"
      },
      "title": "Evidence",
      "type": "array"
    },
    "limitations": {
      "default": [],
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Limitations",
      "type": "array"
    },
    "mapping_confidence": {
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Mapping Confidence",
      "type": "number"
    },
    "observed_paths": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Observed Paths",
      "type": "array"
    },
    "orchestration": {
      "additionalProperties": true,
      "title": "Orchestration",
      "type": "object"
    },
    "pipeline": {
      "additionalProperties": true,
      "title": "Pipeline",
      "type": "object"
    },
    "protocol_version": {
      "default": "sn87/0alpha1",
      "minLength": 1,
      "title": "Protocol Version",
      "type": "string"
    },
    "signal": {
      "additionalProperties": true,
      "title": "Signal",
      "type": "object"
    },
    "source_bindings": {
      "items": {
        "$ref": "#/$defs/SourceBinding"
      },
      "minItems": 1,
      "title": "Source Bindings",
      "type": "array"
    }
  },
  "required": [
    "capsule_id",
    "signal",
    "orchestration",
    "constraints",
    "observed_paths",
    "pipeline",
    "evidence",
    "context",
    "source_bindings",
    "disclosure_policy",
    "mapping_confidence"
  ],
  "title": "AssuranceCapsule",
  "type": "object"
}
