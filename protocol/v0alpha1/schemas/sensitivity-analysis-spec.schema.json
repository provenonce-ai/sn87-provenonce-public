{
  "$defs": {
    "ComponentValue": {
      "additionalProperties": false,
      "properties": {
        "component": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Component",
          "type": "string"
        },
        "value": {
          "$ref": "#/$defs/UnitRatio"
        }
      },
      "required": [
        "component",
        "value"
      ],
      "title": "ComponentValue",
      "type": "object"
    },
    "ComponentVector": {
      "additionalProperties": false,
      "properties": {
        "components": {
          "items": {
            "$ref": "#/$defs/ComponentValue"
          },
          "maxItems": 64,
          "minItems": 1,
          "title": "Components",
          "type": "array"
        },
        "vector_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Vector Id",
          "type": "string"
        }
      },
      "required": [
        "vector_id",
        "components"
      ],
      "title": "ComponentVector",
      "type": "object"
    },
    "EstimatorKind": {
      "enum": [
        "WEIGHTED_ARITHMETIC_MEAN",
        "WEIGHTED_HARMONIC_MEAN"
      ],
      "title": "EstimatorKind",
      "type": "string"
    },
    "EstimatorSpec": {
      "additionalProperties": false,
      "properties": {
        "chain_action_defined": {
          "const": false,
          "title": "Chain Action Defined",
          "type": "boolean"
        },
        "component_weights": {
          "additionalProperties": {
            "$ref": "#/$defs/ExactRatio"
          },
          "minProperties": 1,
          "propertyNames": {
            "maxLength": 128,
            "minLength": 1
          },
          "title": "Component Weights",
          "type": "object"
        },
        "estimator_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Estimator Id",
          "type": "string"
        },
        "estimator_state": {
          "const": "EXPERIMENTAL_NON_NORMATIVE",
          "title": "Estimator State",
          "type": "string"
        },
        "estimator_version": {
          "const": "sn87/transparent-estimator/0alpha1",
          "title": "Estimator Version",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/EstimatorKind"
        },
        "normative_scoring": {
          "const": false,
          "title": "Normative Scoring",
          "type": "boolean"
        },
        "output_semantics": {
          "const": "EXPERIMENTAL_COMPONENT_AGGREGATE",
          "title": "Output Semantics",
          "type": "string"
        },
        "ranking_defined": {
          "const": false,
          "title": "Ranking Defined",
          "type": "boolean"
        },
        "task_profile_commitment": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Task Profile Commitment",
          "type": "string"
        },
        "weight_policy_defined": {
          "const": false,
          "title": "Weight Policy Defined",
          "type": "boolean"
        },
        "winner_selection_defined": {
          "const": false,
          "title": "Winner Selection Defined",
          "type": "boolean"
        }
      },
      "required": [
        "estimator_version",
        "estimator_state",
        "estimator_id",
        "task_profile_commitment",
        "kind",
        "component_weights",
        "output_semantics",
        "normative_scoring",
        "winner_selection_defined",
        "ranking_defined",
        "weight_policy_defined",
        "chain_action_defined"
      ],
      "title": "EstimatorSpec",
      "type": "object"
    },
    "ExactRatio": {
      "additionalProperties": false,
      "properties": {
        "denominator": {
          "exclusiveMinimum": 0,
          "title": "Denominator",
          "type": "integer"
        },
        "numerator": {
          "exclusiveMinimum": 0,
          "title": "Numerator",
          "type": "integer"
        }
      },
      "required": [
        "numerator",
        "denominator"
      ],
      "title": "ExactRatio",
      "type": "object"
    },
    "UnitRatio": {
      "additionalProperties": false,
      "properties": {
        "denominator": {
          "exclusiveMinimum": 0,
          "title": "Denominator",
          "type": "integer"
        },
        "numerator": {
          "minimum": 0,
          "title": "Numerator",
          "type": "integer"
        }
      },
      "required": [
        "numerator",
        "denominator"
      ],
      "title": "UnitRatio",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "analysis_state": {
      "const": "EXPERIMENTAL_NON_NORMATIVE",
      "title": "Analysis State",
      "type": "string"
    },
    "analysis_version": {
      "const": "sn87/transparent-sensitivity-analysis/0alpha1",
      "title": "Analysis Version",
      "type": "string"
    },
    "baseline": {
      "$ref": "#/$defs/ComponentVector"
    },
    "chain_action_defined": {
      "const": false,
      "title": "Chain Action Defined",
      "type": "boolean"
    },
    "estimator_preference_defined": {
      "const": false,
      "title": "Estimator Preference Defined",
      "type": "boolean"
    },
    "estimator_specs": {
      "items": {
        "$ref": "#/$defs/EstimatorSpec"
      },
      "maxItems": 16,
      "minItems": 1,
      "title": "Estimator Specs",
      "type": "array"
    },
    "normative_scoring": {
      "const": false,
      "title": "Normative Scoring",
      "type": "boolean"
    },
    "output_semantics": {
      "const": "DESCRIPTIVE_ESTIMATOR_SENSITIVITY",
      "title": "Output Semantics",
      "type": "string"
    },
    "production_policy_selected": {
      "const": false,
      "title": "Production Policy Selected",
      "type": "boolean"
    },
    "ranking_defined": {
      "const": false,
      "title": "Ranking Defined",
      "type": "boolean"
    },
    "scenarios": {
      "items": {
        "$ref": "#/$defs/ComponentVector"
      },
      "maxItems": 256,
      "minItems": 1,
      "title": "Scenarios",
      "type": "array"
    },
    "task_profile_commitment": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Task Profile Commitment",
      "type": "string"
    },
    "weight_policy_defined": {
      "const": false,
      "title": "Weight Policy Defined",
      "type": "boolean"
    },
    "winner_selection_defined": {
      "const": false,
      "title": "Winner Selection Defined",
      "type": "boolean"
    }
  },
  "required": [
    "analysis_version",
    "analysis_state",
    "task_profile_commitment",
    "estimator_specs",
    "baseline",
    "scenarios",
    "output_semantics",
    "production_policy_selected",
    "estimator_preference_defined",
    "normative_scoring",
    "winner_selection_defined",
    "ranking_defined",
    "weight_policy_defined",
    "chain_action_defined"
  ],
  "title": "SensitivityAnalysisSpec",
  "type": "object"
}
